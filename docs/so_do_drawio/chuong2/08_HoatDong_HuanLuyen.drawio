<mxfile host="app.diagrams.net" type="device"><diagram id="Hinh_2.8_Hoat_dong_huan_luyen" name="Hinh 2.8 Hoat dong huan luyen"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="925" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bd" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;ellipse;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="388.0" y="15" width="24" height="24" as="geometry" /></mxCell><mxCell id="a1" value="Đọc chuỗi từ CSDL (hoặc CSV mở),&lt;br&gt;gom trung bình theo ngày" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="400" height="48" as="geometry" /></mxCell><mxCell id="a2" value="Dựng chuỗi ngày liên tục;&lt;br&gt;ngày thiếu giữ khuyết, không nội suy" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="400" height="48" as="geometry" /></mxCell><mxCell id="a3" value="Tạo đặc trưng: y_t, y_t−1, y_t−2, trung bình 3 và 7 ngày,&lt;br&gt;độ lệch chuẩn 7 ngày, tháng (sin, cos);&lt;br&gt;nhãn y_t+1" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="400" height="62" as="geometry" /></mxCell><mxCell id="a4" value="Chia theo thời gian: phần đầu để huấn luyện,&lt;br&gt;30% thời gian cuối để kiểm tra (không xáo trộn)" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="285" width="400" height="48" as="geometry" /></mxCell><mxCell id="r1" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="355" width="520" height="8" as="geometry" /></mxCell><mxCell id="m1" value="Mốc persistence&lt;br&gt;&amp;quot;mai = hôm nay&amp;quot;" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="200" height="48" as="geometry" /></mxCell><mxCell id="m2" value="Hồi quy tuyến tính&lt;br&gt;(Ridge)" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="300" y="390" width="200" height="48" as="geometry" /></mxCell><mxCell id="m3" value="Random Forest" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="540" y="390" width="200" height="48" as="geometry" /></mxCell><mxCell id="r2" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="465" width="520" height="8" as="geometry" /></mxCell><mxCell id="a5" value="Tính MAE, RMSE; Skill = 1 − RMSE/RMSE_persistence;&lt;br&gt;KTC 95% bootstrap theo khối 7 ngày;&lt;br&gt;tách mùa khô (12–4) và mùa mưa (5–11)" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="495" width="400" height="62" as="geometry" /></mxCell><mxCell id="q" value="Cận dưới KTC 9