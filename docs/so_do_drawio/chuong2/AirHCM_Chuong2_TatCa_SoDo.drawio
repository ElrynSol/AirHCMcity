ng: y_t, y_t−1, y_t−2, trung bình 3 và 7 ngày,&lt;br&gt;độ lệch chuẩn 7 ngày, tháng (sin, cos);&lt;br&gt;nhãn y_t+1" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="400" height="62" as="geometry" /></mxCell><mxCell id="a4" value="Chia theo thời gian: phần đầu để huấn luyện,&lt;br&gt;30% thời gian cuối để kiểm tra (không xáo trộn)" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="285" width="400" height="48" as="geometry" /></mxCell><mxCell id="r1" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="355" width="520" height="8" as="geometry" /></mxCell><mxCell id="m1" value="Mốc persistence&lt;br&gt;&amp;quot;mai = hôm nay&amp;quot;" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="200" height="48" as="geometry" /></mxCell><mxCell id="m2" value="Hồi quy tuyến tính&lt;br&gt;(Ridge)" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="300" y="390" width="200" height="48" as="geometry" /></mxCell><mxCell id="m3" value="Random Forest" style="html=1;whiteSpace=wrap;fontFamily=Arial;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;rounded=1;arcSize=20;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="540" y="390" width="200" height="48" as="geometry" /></mxCell><mxCell id="r2" value="" style="html=1;whiteSpace=wrap;fontFamil