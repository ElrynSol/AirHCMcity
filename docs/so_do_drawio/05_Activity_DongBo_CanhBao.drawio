        <mxCell id="2" value="SƠ ĐỒ HOẠT ĐỘNG — ĐỒNG BỘ DỮ LIỆU TỰ ĐỘNG HẰNG NGÀY &amp; TỰ NẠP BÙ 90 NGÀY" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#0b2545;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1020" height="34" as="geometry"/></mxCell>
