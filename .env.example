# Sao chép thành .env rồi điền giá trị thật — hoặc chạy cai_dat.ps1 (Windows) / cai_dat.sh (Linux, macOS) để tự tạo
# với khóa ngẫu nhiên. KHÔNG commit, KHÔNG nộp file .env.

# ===== Cơ sở dữ liệu =====
# Cách 1 (máy cá nhân): từng biến. Cách 2 (Docker/đám mây): DATABASE_URL=postgresql://user:matkhau@host:5432/ten_csdl
DB_USER=postgres
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=air_quality_db

# ===== Môi trường =====
# development (máy cá nhân, có /docs) | production (máy chủ công khai: tắt /docs, cookie Secure)
MOI_TRUONG=development

# ===== Đăng nhập & bảo mật =====
# Khóa ký JWT: bắt buộc, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Phiên thường hết hạn sau (giây); tự đăng xuất khi không hoạt động (phút); "Ghi nhớ đăng nhập" (ngày)
COOKIE_MAX_AGE=28800
PHIEN_KHONG_HOAT_DONG_PHUT=120
PHIEN_GHI_NHO_NGAY=30
# Email được cấp quyền admin khi đăng ký (cách nhau dấu phẩy). MÁY CHỦ CÔNG KHAI BẮT BUỘC ĐẶT.
# Để trống: tài khoản đầu tiên đăng ký là admin (chỉ dùng trên máy cá nhân).
ADMIN_EMAILS=
# 0 = khóa đăng ký tài khoản mới
CHO_PHEP_DANG_KY=1
# 1 = hiện mã OTP quên mật khẩu ngay trên màn hình khi chưa cấu hình SMTP. CHỈ dùng khi trình diễn trên máy cá nhân.
OTP_DEMO=0
# Khóa mã hóa bí mật xác thực 2 lớp (tùy chọn; để trống thì suy ra từ JWT_SECRET_KEY — đổi JWT_SECRET_KEY sẽ phải bật lại 2FA)
TOTP_ENC_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===== Đăng nhập bằng Google / Facebook / Zalo — hướng dẫn lấy khóa: docs/DANG_NHAP_MXH.md =====
# Để trống cặp nào thì nút đăng nhập tương ứng không hiện.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
ZALO_APP_ID=
ZALO_APP_SECRET=

# ===== Email (OTP quên mật khẩu, cảnh báo) — mật khẩu ứng dụng Gmail, không phải mật khẩu đăng nhập =====
SMTP_USER=
SMTP_PASS=

# ===== Thông báo đẩy chạy nền (Web Push) =====
# Khóa VAPID tự sinh lần đầu ở bi_mat/vapid_private.pem. Email liên hệ gửi kèm (mặc định dùng SMTP_USER)
VAPID_EMAIL=
DAY_CHU_KY_PHUT=30

# ===== Số liệu đo thật tại trạm mặt đất (OpenAQ, miễn phí: https://explore.openaq.org → Account → API Key) =====
# Dùng cho data_pipeline/tai_tram_that.py: đối chiếu và hiệu chỉnh số liệu mô hình CAMS
OPENAQ_API_KEY=

# ===== Google Earth Engine (Sentinel-5P) — tùy chọn =====
GEE_SERVICE_ACCOUNT=
# Đường dẫn khóa service account (tuyệt đối hoặc tương đối so với thư mục dự án)
GEE_KEY_FILE=gee-key.json

# ===== Triển khai lên Internet (docker-compose.prod.yml, xem docs/TRIEN_KHAI_ORACLE.md) =====
# Tên miền trỏ về IP máy chủ (vd. tên miền miễn phí DuckDNS) và email nhận thông báo chứng chỉ HTTPS
TEN_MIEN=
EMAIL_ACME=
# Địa chỉ công khai (SEO: sitemap, thẻ canonical) — Docker production tự đặt = https://TEN_MIEN
DIA_CHI_CONG_KHAI=
# Mã xác minh Google Search Console (thẻ HTML, chỉ phần content="...")
GOOGLE_SITE_VERIFICATION=
# Giới hạn tài nguyên cho Docker (đổi theo cấu hình máy)
DB_RAM=2g
APP_RAM=3g
APP_CPU=2

# Trạm IoT mô phỏng (Wokwi ESP32) qua MQTT — xem iot/README.md. Tắt hẳn: IOT_BAT=0
IOT_BAT=1
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# Tiền tố chủ đề airhcm/<MQTT_DU_AN>/...; phải trùng DU_AN trong 2 file .ino
MQTT_DU_AN=dhtnmt-1250080037
# Khóa thiết bị gửi kèm gói tin; phải trùng KHOA trong iot/wokwi_tram/wokwi_tram.ino
IOT_KHOA_THIET_BI=airhcm-demo-2026
# AQI (trung bình 1 phút) từ mức này trở lên thì phát cảnh báo
IOT_NGUONG_AQI=100
# Để trống: thư cảnh báo IoT chỉ lưu vào Hộp thư đã gửi. Điền email: gửi thật (cần SMTP_USER/SMTP_PASS)
IOT_EMAIL_NHAN=

# Đồng bộ dữ liệu tự động trong máy chủ (bổ sung cho Windows Task Scheduler - xem cai_dat_dong_bo_tu_dong.ps1)
DONG_BO_BAT=1
DONG_BO_GIO=07:45

# Trợ lý AirHCM (nút "✨ Hỏi AI"). Không có khóa: trả lời tự động từ dữ liệu (miễn phí).
# Có khóa: Claude trả lời tự nhiên dựa trên dữ liệu hiện tại (tính phí theo token của Anthropic).
ANTHROPIC_API_KEY=
# TRO_LY_AI=0 để tắt hẳn AI; TRO_LY_AI=1 khi dùng hồ sơ `ant auth login` thay cho khóa
TRO_LY_MODEL=claude-opus-5-5
TRO_LY_EFFORT=low
# Giới hạn chi phí: câu hỏi / 10 phút / IP và câu hỏi AI / giờ toàn hệ thống
TRO_LY_GIOI_HAN_IP=20
TRO_LY_GIOI_HAN_GIO=200

# Gemini cho trợ lý (ưu tiên khi có khóa). Lấy khóa miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng khi model chính hết lượt miễn phí (20 lượt/ngày/model) hoặc quá tải; thử lần lượt từ trái sang phải
# GEMINI_MODELS_DU_PHONG=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
# auto (Gemini → Claude → tự động) | gemini | claude
TRO_LY_NHA_CUNG_CAP=auto
# Tùy chọn: 0 để tắt "suy nghĩ" trên dòng 2.5-flash (trả lời nhanh, rẻ hơn)
GEMINI_THINKING_BUDGET=
